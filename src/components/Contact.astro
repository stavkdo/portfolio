---
// A string: contact
import { site } from "../data/content";

const icons = {
  github:
    "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21",
  linkedin:
    "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4z",
};
const year = new Date().getFullYear();
---

<section class="field field--gold" id="contact">
  <div class="raven">
    <h2 class="raven__heading reveal">Say hello</h2>
    <p class="raven__line reveal">
      Have a question, an opportunity, or just want to talk about a project? I'd love to hear from you.
    </p>
    <a class="raven__mail reveal" href={`mailto:${site.email}`}>{site.email}</a>
    <ul class="raven__links reveal">
      <li>
        <a href={site.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.github}></path></svg>
          GitHub
        </a>
      </li>
      <li>
        <a href={site.linkedin} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.linkedin}></path></svg>
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
  <footer class="colophon">
    <p>{site.firstName} {site.lastName} · {year}</p>
  </footer>
</section>
